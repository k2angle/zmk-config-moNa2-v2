#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 3

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        studio-unlock {
            bindings = <&studio_unlock>;
            key-positions = <26 27>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        mb1 {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <19 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R         &kp T                                                  &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &kp F         &kp G                                   &kp F7         &kp H        &kp J  &lt 3 K    &lt 1 L  &kp MINUS
&kp Z      &kp X         &kp C         &kp V         &kp B        &lt 3 ESC                  &kp F10        &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_GUI  &lt 1 SPACE  &mt LEFT_SHIFT CAPSLOCK    &kp BACKSPACE  &lt 2 ENTER                             &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp LEFT_BRACE        &kp RIGHT_BRACE                                         &kp RS(RC(RG(NUMBER_4)))  &kp RC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES
&kp DOLLAR       &kp PERCENT  &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET                &trans                 &kp RG(R)                 &mkp MB1            &mkp MB2             &kp SEMICOLON     &kp COLON
&kp CARET        &kp INT_YEN  &trans         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &kp RG(W)              &kp RG(C)                 &kp RG(V)           &kp RG(RA(V))        &kp TILDE         &kp GRAVE
&trans           &trans       &trans         &trans                &trans                 &trans    &kp RG(RIGHT_BRACKET)  &kp RG(LEFT_BRACKET)                                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };

        layer_2 {
            bindings = <
&kp BACKSPACE         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT                            &kp RC(UP_ARROW)  &kp RS(P)           &kp UP_ARROW         &kp RS(N)          &kp DELETE
&kp NON_US_BACKSLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS                   &trans  &msc SCRL_UP      &kp LEFT_ARROW      &kp DOWN_ARROW       &kp RIGHT_ARROW    &kp K_MUTE
&kp KP_NUMBER_0       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS  &trans          &trans  &msc SCRL_DOWN    &kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&trans                &trans           &trans           &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_EQUAL    &trans  &trans                                                                        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_3 {
            bindings = <
&trans     &trans     &trans              &trans               &kp LG(BACKSPACE)                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans     &kt LG(S)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)  &trans                       &trans       &trans        &trans        &trans        &trans        &trans
&kp LG(Z)  &trans     &trans              &trans               &trans             &trans    &bootloader  &trans        &trans        &trans        &trans        &trans
&trans     &trans     &trans              &trans               &trans             &trans    &trans       &trans                                                  &bt BT_CLR
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
